---
import Layout from '../../layouts/Layout.astro';
import AppLandingPage from '../../components/AppLandingPage.astro';
import { appPages, type AppPage } from '../../data/appPages';

export function getStaticPaths() {
  return appPages.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

interface Props { app: AppPage }
const { app } = Astro.props;
const canonicalUrl = `https://savoie.app/apps/${app.slug}/`;
const appleAppId = app.appStoreUrl.match(/id(\d+)/)?.[1];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: `${app.name} — ${app.headline}`,
      description: app.subhead,
      isPartOf: { '@id': 'https://savoie.app/#website' },
      about: { '@id': `${canonicalUrl}#app` },
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${canonicalUrl}#app`,
      name: app.name,
      applicationCategory: app.category,
      operatingSystem: 'iOS',
      description: app.subhead,
      url: canonicalUrl,
      image: `https://savoie.app${app.icon}`,
      downloadUrl: app.appStoreUrl,
      installUrl: app.appStoreUrl,
      author: { '@id': 'https://savoie.app/#eric-savoie' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP', availability: 'https://schema.org/InStock' },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: app.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Savoie Apps', item: 'https://savoie.app/' },
        { '@type': 'ListItem', position: 2, name: app.name, item: canonicalUrl },
      ],
    },
  ],
};
---

<Layout
  title={`${app.name} — ${app.headline}`}
  description={app.subhead}
  canonicalUrl={canonicalUrl}
  ogImage={`https://savoie.app${app.heroScreenshot}`}
  analyticsPageType="app_product_page"
  analyticsApp={app.name}
  appleAppId={appleAppId}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <AppLandingPage app={app} />
</Layout>
