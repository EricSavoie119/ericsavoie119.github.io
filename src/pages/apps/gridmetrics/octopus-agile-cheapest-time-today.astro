---
import Layout from '../../../layouts/Layout.astro';
import GridUtilityPage from '../../../components/GridUtilityPage.astro';
import { getAgileTimeData } from '../../../lib/gridMetricsData';
import { appStoreCampaignUrl, gridMetricsOctopusExperiment } from '../../../data/experiments';

const data = await getAgileTimeData();
const defaultRegion = data.regions.find((region) => region.code === 'C') ?? data.regions[0];
const canonicalUrl = 'https://savoie.app/apps/gridmetrics/octopus-agile-cheapest-time-today/';
const title = 'Octopus Agile Cheapest Time Today | GridMetrics';
const description = 'Find today’s cheapest remaining Octopus Agile electricity window for your region, from 30 minutes to four hours, using public VAT-inclusive rates.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl,
  dateModified: data.generatedAt,
  isPartOf: { '@type': 'WebSite', name: 'Savoie Apps', url: 'https://savoie.app/' },
  about: { '@type': 'Thing', name: 'Octopus Agile electricity prices' },
};
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage="https://savoie.app/assets/images/apps/GridMetrics/utility-og.png"
  analyticsPageType="acquisition_tool"
  analyticsApp="GridMetrics"
  analyticsExperimentId={gridMetricsOctopusExperiment.id}
  appleAppId="6752292390"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <GridUtilityPage
    mode="price"
    eyebrow="Today · Live Agile prices"
    title="Cheapest time."
    intro="Choose your region and duration."
    generatedAt={data.generatedAt}
    recommendationDate={defaultRegion?.recommendationDate ?? null}
    recommendations={defaultRegion?.recommendations ?? []}
    regions={data.regions}
    activeRegionCode={defaultRegion?.code}
    available={data.available}
    sourceLabel="Octopus Energy public API"
    sourceUrl="https://developer.octopus.energy/guides/rest/api-endpoints/"
    explanation="Uses public VAT-inclusive Agile rates and checks every remaining consecutive half-hour period for the lowest average."
    appStoreUrl={appStoreCampaignUrl(gridMetricsOctopusExperiment)}
    campaignToken={gridMetricsOctopusExperiment.campaignToken}
  />
</Layout>
