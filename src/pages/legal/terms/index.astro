<style>
  .terms { padding: 4rem 0; }
  .terms .container { max-width: 720px; }
  h1 { font-size: 2rem; font-weight: 800; color: var(--color-text-primary); margin-bottom: 0.5rem; letter-spacing: -0.5px; }
  .meta { font-size: 0.8rem; color: var(--color-text-secondary); margin-bottom: 2rem; }
  h2 { font-size: 1.1rem; font-weight: 700; color: var(--color-text-primary); margin-top: 2rem; margin-bottom: 0.5rem; }
  h3 { font-size: 0.95rem; font-weight: 600; color: var(--color-text-primary); margin-top: 1.25rem; margin-bottom: 0.4rem; }
  p, li { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.7; }
  ul { padding-left: 1.25rem; margin: 0.5rem 0; }
  li { margin-bottom: 0.25rem; }
  a { color: var(--color-accent); }
  .note { font-size: 0.8rem; margin-top: 2rem; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
