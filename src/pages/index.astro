---
import Layout from '../layouts/Layout.astro';
import FeaturedApps from '../components/FeaturedApps.astro';
import featuredStyles from '../styles/featured-apps.css?url';
import homeStyles from '../styles/mountain-home.css?url';
import { retiredApps } from '../data/apps';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://savoie.app/#website',
      url: 'https://savoie.app/',
      name: 'Savoie Apps',
      description: 'Small independent iPhone apps across productivity, finance, and utilities.',
      publisher: { '@id': 'https://savoie.app/#savoie-apps' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://savoie.app/#savoie-apps',
      name: 'Savoie Apps',
      url: 'https://savoie.app/',
      logo: 'https://savoie.app/assets/images/savoie-apps-social-preview.png',
    },
  ],
};
---
<Layout title="Savoie Apps | Apps & Tools" description="Independent iPhone apps and useful tools from Savoie Apps. Explore BeLoved, Flip Clock Flow, Infinite Ruler and more, or get in touch about working together." canonicalUrl="https://savoie.app/" ogImageAlt="Savoie Apps — Small iPhone apps, thoughtfully made." analyticsPageType="portfolio_home" customStyles>
  <link slot="head" rel="stylesheet" href={homeStyles} />
  <link slot="head" rel="stylesheet" href={featuredStyles} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <a class="skip-link" href="#apps">Skip to apps</a>
  <header class="hero" id="top">
    <img class="landscape" src="/assets/home/mountain.webp" alt="A small figure standing on a rocky ridge beneath a vast cloudy mountain sky" fetchpriority="high">
    <nav aria-label="Main navigation"><a class="brand" href="#top">savoie<span>✳</span></a><div class="links"><a href="#apps">Apps & tools</a><a class="about-link" href="#about">The person behind them</a><a class="contact" href="mailto:eric@savoie.app" data-analytics-event="developer_contact_opened" data-analytics-destination="email" data-analytics-placement="portfolio_home">Say hello<svg viewBox="0 0 30 26" aria-hidden="true" focusable="false"><path d="M3 22 C14 23 11 8 25 5 M18 3 Q23 4 25 5 Q25 10 23 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div></nav>
    <h1 class="sr-only">Eric Savoie — apps & tools</h1>
    <div class="hero-content"><a class="cta trail-link" href="#apps"><span>View my apps</span><svg viewBox="0 0 230 250" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path class="unwind-line" d="M8 97 C-55 28 100 -2 173 18 C260 37 255 105 150 113 C100 119 35 120 8 97"/><path class="unwind-tip" d="M180 218 Q190 225 192 228 Q197 217 204 212" opacity="0"/></svg></a></div>
    <div id="stage" aria-label="Introduction concept"></div>
  </header>
  <main id="apps" tabindex="-1">
    <h2 class="sr-only">Apps & tools</h2>
    <FeaturedApps />
    <section class="more-apps"><h2>Also made<br><em>by me.</em></h2>
    <div class="catalogue">
      <a class="app-row" href="/apps/look-at-yourself/" data-analytics-event="product_page_opened" data-analytics-app="LookAtYourself" data-analytics-placement="portfolio_home"><img src="/assets/images/apps/LookAtYourself/icon.webp" alt="" loading="lazy"><div><h3>LookAtYourself</h3><p>A moment to pause before you keep scrolling.</p></div><span class="arrow">↗</span></a>
      <a class="app-row" href="/apps/gridmetrics/" data-analytics-event="product_page_opened" data-analytics-app="GridMetrics" data-analytics-placement="portfolio_home"><img src="/assets/images/thumbs/gridmetrics.webp" alt="" loading="lazy"><div><h3>GridMetrics</h3><p>Find a cleaner time to use electricity.</p></div><span class="arrow">↗</span></a>
      <a class="app-row" href="/apps/bread-engineer/" data-analytics-event="product_page_opened" data-analytics-app="Bread Engineer" data-analytics-placement="portfolio_home"><img src="/assets/images/thumbs/bread-engineer.webp" alt="" loading="lazy"><div><h3>Bread Engineer</h3><p>Bread recipes, dough timing and step alarms.</p></div><span class="arrow">↗</span></a>
      <a class="app-row" href="/apps/fast-simple-invoice-maker/" data-analytics-event="product_page_opened" data-analytics-app="Fast Simple Invoice Maker" data-analytics-placement="portfolio_home"><img src="/assets/images/thumbs/fast-simple-invoice-maker.webp" alt="" loading="lazy"><div><h3>Fast Simple Invoice Maker</h3><p>Professional invoices, without the busywork.</p></div><span class="arrow">↗</span></a>
      <a class="app-row" href="/apps/easymode/" data-analytics-event="product_page_opened" data-analytics-app="Easymode" data-analytics-placement="portfolio_home"><img src="/assets/images/apps/EasyMode/icon.webp" alt="" loading="lazy"><div><h3>Easymode <span class="soon">COMING SOON</span></h3><p>A calmer way to manage life admin.</p></div><span class="arrow">↗</span></a>
    </div>
    </section>
  </main>
  <section class="work" id="about"><div><h2>Work with me</h2><p>For projects, roles or collaborations, get in touch.</p></div><a href="mailto:eric@savoie.app?subject=Let%E2%80%99s%20work%20together" data-analytics-event="developer_contact_opened" data-analytics-destination="email" data-analytics-placement="portfolio_home">eric@savoie.app ↗</a></section>
  <section class="past-projects" id="retired"><details><summary>Past projects</summary><p>Earlier experiments, now retired and no longer maintained.</p><ul>{retiredApps.map(app => <li><h3>{app.name}</h3><p>{app.description}</p></li>)}</ul></details></section>
  <footer><a href="#top">SAVOIE</a><div class="footer-links"><a href="/guides/">Guides</a><a href="https://github.com/EricSavoie119">GitHub</a><a href="/legal/privacy-policy/">Privacy</a><a href="/legal/terms/">Terms</a></div></footer>
  <script is:inline src="/assets/home/scroll-motion.js"></script>
  <script is:inline src="/assets/home/introductions.js"></script>
  <script is:inline src="/assets/home/unwind-link.js"></script>
  <script is:inline src="/assets/home/portrait-dock.js"></script>
  <script is:inline src="/assets/home/cta-swerve.js"></script>
  <script is:inline src="/assets/home/featured-video.js"></script>
  <script is:inline src="/assets/home/featured-apps.js"></script>

</Layout>
