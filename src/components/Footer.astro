</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
    margin-top: 4rem;
  }
  .footer .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }
  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .footer-links svg {
    display: block;
  }
  .footer .sep {
    color: var(--color-border);
  }
  .footer a {
    color: var(--color-text-secondary);
    transition: color 150ms ease;
  }
  .footer a:hover {
    color: var(--color-accent);
  }
</style>
