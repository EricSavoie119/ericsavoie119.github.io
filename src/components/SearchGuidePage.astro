---
import type { SearchGuide } from '../data/guides';

interface Props {
  guide: SearchGuide;
  relatedGuides: SearchGuide[];
}

const { guide, relatedGuides } = Astro.props;
---

<div class="guide-page" style={`--guide-accent:${guide.accent}`}>
  <header class="guide-nav">
    <a class="guide-brand" href="/" aria-label="Savoie Apps home">
      <span class="brand-mark">S</span>
      <span>Savoie Apps</span>
    </a>
    <a class="app-link" href={`/apps/${guide.appSlug}/`} data-analytics-event="product_page_opened" data-analytics-app={guide.appName} data-analytics-placement="guide_nav">
      <img src={guide.appIcon} alt="" width="34" height="34" />
      <span>{guide.appName}</span>
    </a>
  </header>

  <main>
    <article>
      <header class="article-header">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Apps</a><span aria-hidden="true">/</span><span>Guides</span>
        </nav>
        <p class="eyebrow">{guide.eyebrow}</p>
        <h1>{guide.title}</h1>
        <p class="standfirst">{guide.introduction}</p>
        <div class="article-meta">
          <span>{guide.readingTime}</span>
          <span>Updated <time datetime={guide.updatedAt}>{new Date(`${guide.updatedAt}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></span>
        </div>
      </header>

      <div class="article-body">
        {guide.sections.map((section, index) => (
          <section class="guide-section">
            <span class="section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h2>{section.title}</h2>
            {section.body.map((paragraph) => <p>{paragraph}</p>)}
            {section.steps && (
              <ol>
                {section.steps.map((step) => <li>{step}</li>)}
              </ol>
            )}
            {section.note && <aside class="note"><strong>Privacy note</strong><p>{section.note}</p></aside>}
          </section>
        ))}
      </div>

      <section class="app-bridge" aria-labelledby="app-bridge-title">
        <img src={guide.appIcon} alt={`${guide.appName} app icon`} width="76" height="76" />
        <div>
          <p class="eyebrow">The app behind this guide</p>
          <h2 id="app-bridge-title">Try the idea with {guide.appName}.</h2>
          <p>See the complete feature set, privacy details and current availability on the {guide.appName} page.</p>
          <div class="bridge-actions">
            <a class="primary" href={`/apps/${guide.appSlug}/`} data-analytics-event="product_page_opened" data-analytics-app={guide.appName} data-analytics-placement="guide_body">Explore {guide.appName}</a>
            {guide.appStoreUrl && <a class="secondary" href={guide.appStoreUrl} target="_blank" rel="noopener noreferrer" data-app-store-cta="guide_body" data-analytics-app={guide.appName}>View on the App Store</a>}
          </div>
        </div>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <p class="eyebrow">Common questions</p>
        <h2 id="faq-title">A few useful details.</h2>
        <div class="faq-list">
          {guide.faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      {relatedGuides.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <p class="eyebrow">Keep going</p>
          <h2 id="related-title">Related guides</h2>
          <div class="related-grid">
            {relatedGuides.map((related) => (
              <a href={`/guides/${related.slug}/`} data-analytics-event="related_guide_opened" data-analytics-app={guide.appName} data-analytics-placement="guide_footer" data-analytics-destination={related.slug}>
                <span>{related.eyebrow}</span>
                <strong>{related.title}</strong>
                <span aria-hidden="true">Read the guide →</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>

  <footer>
    <span>© {new Date().getFullYear()} Savoie Apps</span>
    <nav aria-label="Footer">
      <a href="/legal/privacy-policy/">Privacy</a>
      <a href="mailto:eric@savoie.app">Support</a>
      <a href="/">All apps</a>
    </nav>
  </footer>
</div>

<style>
  .guide-page { background: #f7f9fc; color: #13213a; min-height: 100vh; }
  .guide-nav { align-items: center; display: flex; justify-content: space-between; margin: 0 auto; max-width: 1160px; padding: 22px 28px; }
  .guide-brand, .app-link { align-items: center; display: flex; font-size: .82rem; font-weight: 800; gap: 10px; }
  .brand-mark { align-items: center; background: #0b1d38; border-radius: 10px; color: white; display: inline-flex; height: 34px; justify-content: center; width: 34px; }
  .app-link { background: white; border: 1px solid #dce3ee; border-radius: 999px; padding: 6px 14px 6px 7px; }
  .app-link img { border-radius: 22%; }
  article { margin: 0 auto; max-width: 920px; padding: 80px 28px 110px; }
  .article-header { max-width: 860px; }
  .breadcrumbs { color: #748198; display: flex; font-size: .74rem; gap: 10px; margin-bottom: 54px; }
  .breadcrumbs a:hover { color: var(--guide-accent); }
  .eyebrow { color: var(--guide-accent); font-size: .75rem; font-weight: 800; letter-spacing: .13em; margin: 0 0 18px; text-transform: uppercase; }
  h1, h2 { color: #0b1d38; letter-spacing: -.045em; line-height: 1.04; }
  h1 { font-size: clamp(3rem, 7vw, 5.8rem); margin: 0; }
  h2 { font-size: clamp(2rem, 4vw, 3.25rem); margin: 0 0 24px; }
  .standfirst { color: #53627a; font-size: clamp(1.12rem, 2vw, 1.36rem); line-height: 1.7; margin: 34px 0 26px; max-width: 780px; }
  .article-meta { border-top: 1px solid #dce3ee; color: #748198; display: flex; font-size: .72rem; gap: 26px; padding-top: 18px; }
  .article-body { margin: 110px auto 0; max-width: 760px; }
  .guide-section { border-top: 1px solid #dce3ee; padding: 76px 0 32px; position: relative; }
  .section-number { color: var(--guide-accent); font-size: .72rem; font-weight: 800; left: -56px; position: absolute; top: 84px; }
  .guide-section > p, .app-bridge p, details p { color: #53627a; font-family: Inter, ui-sans-serif, -apple-system, sans-serif; font-size: 1.08rem; line-height: 1.82; }
  .guide-section ol { counter-reset: guide-step; display: grid; gap: 14px; list-style: none; margin: 34px 0; padding: 0; }
  .guide-section li { align-items: start; background: white; border: 1px solid #e0e7f0; border-radius: 16px; color: #34445d; display: grid; font-family: Inter, ui-sans-serif, -apple-system, sans-serif; gap: 14px; grid-template-columns: 28px 1fr; line-height: 1.62; padding: 18px 20px; }
  .guide-section li::before { align-items: center; background: color-mix(in srgb, var(--guide-accent) 12%, white); border-radius: 999px; color: var(--guide-accent); content: counter(guide-step); counter-increment: guide-step; display: flex; font-family: "JetBrains Mono", monospace; font-size: .7rem; font-weight: 800; height: 28px; justify-content: center; width: 28px; }
  .note { background: color-mix(in srgb, var(--guide-accent) 8%, white); border-left: 3px solid var(--guide-accent); border-radius: 0 14px 14px 0; margin-top: 34px; padding: 20px 24px; }
  .note strong { color: var(--guide-accent); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
  .note p { color: #53627a; font-family: Inter, ui-sans-serif, -apple-system, sans-serif; line-height: 1.65; margin: 8px 0 0; }
  .app-bridge { align-items: start; background: #0b1d38; border-radius: 32px; color: white; display: grid; gap: 28px; grid-template-columns: auto 1fr; margin: 90px 0 120px; padding: 44px; }
  .app-bridge img { border-radius: 22%; box-shadow: 0 16px 34px rgba(0,0,0,.25); }
  .app-bridge h2 { color: white; font-size: clamp(2rem, 4vw, 3.2rem); }
  .app-bridge p { color: #b8c5d8; }
  .bridge-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .bridge-actions a { border-radius: 999px; font-size: .76rem; font-weight: 800; padding: 13px 18px; }
  .bridge-actions .primary { background: white; color: #0b1d38; }
  .bridge-actions .secondary { border: 1px solid #52647e; color: white; }
  .faq { padding-top: 20px; }
  .faq-list { border-top: 1px solid #dce3ee; margin-top: 42px; }
  details { border-bottom: 1px solid #dce3ee; padding: 24px 2px; }
  summary { cursor: pointer; font-size: 1rem; font-weight: 800; }
  details p { margin-bottom: 0; max-width: 720px; }
  .related { border-top: 1px solid #dce3ee; margin-top: 110px; padding-top: 72px; }
  .related h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .related-grid { display: grid; gap: 16px; grid-template-columns: repeat(2, 1fr); }
  .related-grid a { background: white; border: 1px solid #dce3ee; border-radius: 20px; display: flex; flex-direction: column; min-height: 190px; padding: 24px; }
  .related-grid span { color: var(--guide-accent); font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .related-grid strong { font-size: 1.08rem; line-height: 1.45; margin: 12px 0 auto; }
  footer { background: #071426; color: #9aabc2; display: flex; font-size: .72rem; justify-content: space-between; padding: 30px max(28px, calc((100vw - 1104px) / 2)); }
  footer nav { display: flex; gap: 24px; }
  @media (max-width: 720px) {
    article { padding-top: 54px; }
    .article-header { text-align: left; }
    .breadcrumbs { margin-bottom: 42px; }
    .article-body { margin-top: 80px; }
    .section-number { display: block; margin-bottom: 14px; position: static; }
    .app-bridge { display: block; padding: 30px 24px; }
    .app-bridge img { margin-bottom: 28px; }
    .related-grid { grid-template-columns: 1fr; }
    footer { flex-direction: column; gap: 18px; }
  }
  @media (max-width: 480px) {
    .guide-nav { padding: 16px; }
    .guide-brand > span:last-child { display: none; }
    article { padding-left: 20px; padding-right: 20px; }
    .article-meta { flex-direction: column; gap: 8px; }
  }
</style>
