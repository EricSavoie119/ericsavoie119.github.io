---
import type { AppPage } from '../data/appPages';

interface Props {
  app: AppPage;
}

const { app } = Astro.props;
const isPilot = !app.appStoreUrl;
const privacyHref = app.slug === 'bread-engineer'
  ? '/apps/bread-engineer/privacy/'
  : app.slug === 'gridmetrics'
    ? '/apps/gridmetrics/privacy/'
  : app.slug === 'infinite-ruler'
    ? '/apps/infinite-ruler/privacy/'
    : '/legal/privacy-policy/';
const supportHref = app.slug === 'bread-engineer'
  ? '/apps/bread-engineer/support/'
  : app.slug === 'beloved'
    ? '/apps/beloved/support/'
  : app.slug === 'gridmetrics'
    ? '/apps/gridmetrics/support/'
    : app.slug === 'easymode'
      ? '/apps/easymode/support/'
    : app.slug === 'infinite-ruler'
      ? '/apps/infinite-ruler/support/'
      : 'mailto:eric@savoie.app';
const privacyUrl = app.slug === 'easymode' ? '/apps/easymode/privacy/' : privacyHref;
---

<div class:list={['sales-page', `app-${app.slug}`]} style={`--app-accent:${app.accent};--app-accent-dark:${app.accentDark}`}>
  <header class="sales-nav">
    <a class="brand" href="/" aria-label="Savoie Apps home">
      <img src={app.icon} alt="" width="42" height="42" />
      <span>{app.name}</span>
    </a>
    <a class="nav-cta" href={isPilot ? '#how-it-works' : app.appStoreUrl} data-app-store-cta={isPilot ? undefined : 'nav'} data-analytics-app={app.name} target={isPilot ? undefined : '_blank'} rel={isPilot ? undefined : 'noopener noreferrer'}>
      {isPilot ? 'How it helps' : 'Get the app'}
    </a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{app.eyebrow}</p>
        <h1>{app.headline}</h1>
        <p class="lede">{app.subhead}</p>
        <div class="hero-actions">
          {isPilot ? (
            <a class="primary-button" href="#how-it-works">See how Easymode helps</a>
          ) : (
            <a class="store-button" href={app.appStoreUrl} data-app-store-cta="hero" data-analytics-app={app.name} target="_blank" rel="noopener noreferrer">
              <span class="apple" aria-hidden="true"></span>
              <span><small>Download on the</small>App Store</span>
            </a>
          )}
          <span class="no-account">{isPilot ? 'Less to remember. More room to think.' : 'No account required'}</span>
        </div>
      </div>
      <div class="hero-art" style={`--hero-focus-y:${app.heroFocusY ?? '0px'}`}>
        <div class="orb orb-one"></div>
        <div class="orb orb-two"></div>
        <img src={app.heroScreenshot} alt={app.heroScreenshotAlt} width="660" height="1434" fetchpriority="high" />
      </div>
    </section>

    <section class="promise-strip" aria-label={`${app.name} benefits`}>
      {app.benefits.map((benefit) => <span>{benefit}</span>)}
    </section>

    {app.slug === 'gridmetrics' && (
      <section class="live-tools" aria-labelledby="live-tools-title">
        <div>
          <p class="eyebrow">Live on the web</p>
          <h2 id="live-tools-title">Check today before you download.</h2>
          <p>Use the public forecast tools to see a real recommendation, then get GridMetrics for regional results, widgets and alerts.</p>
        </div>
        <div class="live-tool-links">
          <a href="/apps/gridmetrics/cleanest-time-today/" data-analytics-event="web_tool_opened" data-analytics-app="GridMetrics" data-analytics-placement="product_page" data-analytics-destination="cleanest_time">
            <span>Great Britain forecast</span>
            <strong>Cleanest time today</strong>
            <span aria-hidden="true">↗</span>
          </a>
          <a href="/apps/gridmetrics/octopus-agile-cheapest-time-today/" data-analytics-event="web_tool_opened" data-analytics-app="GridMetrics" data-analytics-placement="product_page" data-analytics-destination="cheapest_time">
            <span>Public Agile rates</span>
            <strong>Cheapest time today</strong>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    )}

    <section class="story" id="how-it-works">
      {app.sections.map((section, index) => (
        <article class:list={['story-row', { reverse: index % 2 === 1 }]}>
          <div class="story-copy">
            <p class="eyebrow">{section.eyebrow}</p>
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </div>
          <div
            class:list={['screen-card', { 'widget-card': section.format === 'widget' }]}
            style={`--screen-focus-y:${section.focusY ?? '0px'}`}
          >
            <img
              src={section.screenshot}
              alt={section.screenshotAlt}
              width={section.format === 'widget' ? 492 : 660}
              height={section.format === 'widget' ? 492 : 1434}
              loading="lazy"
            />
          </div>
        </article>
      ))}
    </section>

    <section class="trust">
      <div>
        <p class="eyebrow">{app.trustEyebrow}</p>
        <h2>{app.trustTitle}</h2>
      </div>
      <p>{app.trustBody}</p>
    </section>

    <section class="faq">
      <p class="eyebrow">The practical details</p>
      <h2>Questions, answered.</h2>
      <div class="faq-list">
        {app.faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="final-cta">
      <img src={app.icon} alt={`${app.name} app icon`} width="86" height="86" />
      <p class="eyebrow">{app.finalEyebrow}</p>
      <h2>{app.headline}</h2>
      {isPilot ? (
        <a class="primary-button light" href="/apps/easymode/privacy/">Read the Privacy Notice</a>
      ) : (
        <a class="store-button" href={app.appStoreUrl} data-app-store-cta="footer" data-analytics-app={app.name} target="_blank" rel="noopener noreferrer">
          <span class="apple" aria-hidden="true"></span>
          <span><small>Download on the</small>App Store</span>
        </a>
      )}
    </section>
  </main>

  <footer class="sales-footer">
    <span>© {new Date().getFullYear()} Eric Savoie</span>
    <nav aria-label="Legal">
      <a href={privacyUrl}>Privacy</a>
      {app.slug === 'easymode' && <a href="/apps/easymode/terms/">Terms</a>}
      <a href={supportHref}>Support</a>
      {app.slug === 'easymode' && <a href="/apps/easymode/account-deletion/">Account deletion</a>}
      <a href="/">More apps</a>
    </nav>
    <p>{app.footnote}</p>
  </footer>
</div>

<style>
  .sales-page { background: #f6f9ff; color: #0d1f3c; min-height: 100vh; font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  .sales-nav { align-items: center; display: flex; justify-content: space-between; margin: 0 auto; max-width: 1200px; padding: 22px 32px; }
  .brand { align-items: center; display: flex; font-weight: 750; gap: 12px; letter-spacing: -.02em; }
  .brand img, .final-cta img { border-radius: 22%; box-shadow: 0 8px 24px rgba(10,59,153,.16); }
  .nav-cta { background: #fff; border: 1px solid rgba(10,59,153,.14); border-radius: 999px; color: var(--app-accent-dark); font-size: .9rem; font-weight: 750; padding: 10px 18px; }
  .hero { align-items: center; display: grid; grid-template-columns: 1.05fr .95fr; margin: 0 auto; max-width: 1200px; min-height: 780px; overflow: hidden; padding: 54px 32px 80px; }
  .hero-copy { max-width: 660px; position: relative; z-index: 2; }
  .eyebrow { color: var(--app-accent); font-size: .78rem; font-weight: 800; letter-spacing: .14em; margin-bottom: 18px; text-transform: uppercase; }
  h1, h2 { color: #0b1d38; letter-spacing: -.055em; line-height: .98; }
  h1 { font-size: clamp(3.8rem, 7.5vw, 7rem); margin: 0 0 30px; max-width: 820px; }
  h2 { font-size: clamp(2.5rem, 5vw, 4.5rem); margin: 0 0 24px; }
  .lede { color: #506079; font-size: clamp(1.08rem, 1.8vw, 1.32rem); line-height: 1.65; max-width: 620px; }
  .hero-actions { align-items: center; display: flex; flex-wrap: wrap; gap: 18px; margin-top: 34px; }
  .store-button { align-items: center; background: #0b1320; border-radius: 14px; color: white; display: inline-flex; font-weight: 700; gap: 11px; line-height: 1.08; padding: 11px 18px 12px; }
  .primary-button { align-items: center; background: #0b1320; border-radius: 999px; color: #fff; display: inline-flex; font-size: .94rem; font-weight: 750; justify-content: center; min-height: 48px; padding: 0 24px; }
  .primary-button.light { background: #fff; color: #0b1d38; }
  .store-button small { display: block; font-size: .62rem; font-weight: 500; margin-bottom: 2px; }
  .apple { display: block; font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 1.65rem; font-weight: 400; line-height: 1; }
  .no-account { color: #6f7d92; font-size: .86rem; }
  .hero-art { align-self: end; border-radius: 48px 48px 0 0; height: 690px; overflow: hidden; position: relative; }
  .hero-art img { border-radius: 44px; bottom: -150px; filter: drop-shadow(0 34px 50px rgba(17,52,110,.2)); height: auto; left: 50%; max-width: 430px; position: absolute; transform: translate(-50%, var(--hero-focus-y)); width: 74%; z-index: 2; }
  .app-easymode .hero { column-gap: 48px; grid-template-columns: 1fr 1fr; }
  .app-easymode .hero-art { justify-self: center; max-width: 520px; width: 100%; }
  .app-easymode .hero-art img { bottom: auto; top: 24px; width: 78%; }
  .orb { border-radius: 999px; filter: blur(2px); position: absolute; }
  .orb-one { background: linear-gradient(145deg, color-mix(in srgb, var(--app-accent) 18%, white), color-mix(in srgb, var(--app-accent) 5%, white)); height: 540px; left: 50%; top: 70px; transform: translateX(-50%); width: 540px; }
  .orb-two { background: color-mix(in srgb, var(--app-accent) 26%, transparent); height: 230px; right: 0; top: 0; width: 230px; }
  .promise-strip { background: #0b1d38; color: white; display: grid; font-size: .85rem; font-weight: 700; grid-template-columns: repeat(3, 1fr); letter-spacing: .02em; padding: 26px max(32px, calc((100vw - 1136px)/2)); text-align: center; }
  .promise-strip span + span { border-left: 1px solid rgba(255,255,255,.2); }
  .live-tools { align-items: end; background: #fff; display: grid; gap: 70px; grid-template-columns: .9fr 1.1fr; margin: 0 auto; max-width: 1200px; padding: 100px 32px 20px; }
  .live-tools h2 { font-size: clamp(2.5rem, 4.5vw, 4rem); }
  .live-tools h2::before { content: none; }
  .live-tools > div > p:last-child { color: #586a83; line-height: 1.7; margin-top: 22px; max-width: 520px; }
  .live-tool-links { display: grid; gap: 12px; }
  .live-tool-links a { align-items: center; background: #f4f8ff; border: 1px solid #dce8f8; border-radius: 18px; display: grid; gap: 5px 18px; grid-template-columns: 1fr auto; padding: 20px 22px; }
  .live-tool-links a > span:first-child { color: #2876ff; font-size: .68rem; font-weight: 800; grid-column: 1; letter-spacing: .08em; text-transform: uppercase; }
  .live-tool-links strong { font-size: 1.05rem; grid-column: 1; }
  .live-tool-links a > span:last-child { color: #2876ff; font-size: 1.2rem; grid-column: 2; grid-row: 1 / 3; }
  .story { margin: 0 auto; max-width: 1120px; padding: 130px 32px 60px; }
  .story-row { align-items: center; display: grid; gap: clamp(50px, 9vw, 130px); grid-template-columns: 1fr .8fr; margin-bottom: 150px; }
  .story-row.reverse .story-copy { order: 2; }
  .story-copy > p:last-child, .trust > p { color: #586a83; font-size: 1.08rem; line-height: 1.7; }
  .screen-card { align-items: flex-start; background: linear-gradient(145deg, color-mix(in srgb, var(--app-accent) 12%, white), #fff); border: 1px solid color-mix(in srgb, var(--app-accent) 14%, transparent); border-radius: 42px; display: flex; height: 650px; justify-content: center; overflow: hidden; padding: 42px 44px 0; }
  .screen-card img { border-radius: 34px; flex: 0 0 auto; filter: drop-shadow(0 25px 36px rgba(17,52,110,.18)); height: auto; max-width: 340px; object-fit: contain; object-position: top; transform: translateY(var(--screen-focus-y)); width: 100%; }
  .widget-card { align-items: center; background: radial-gradient(circle at 50% 42%, #fafdff 0, #e4efff 72%); padding: 60px; }
  .widget-card img { border-radius: 24%; filter: drop-shadow(0 28px 36px rgba(17,52,110,.22)); max-width: 390px; object-position: center; }
  .trust { background: color-mix(in srgb, var(--app-accent) 9%, white); border-radius: 40px; display: grid; gap: 80px; grid-template-columns: 1fr 1fr; margin: 0 auto 140px; max-width: 1120px; padding: clamp(42px, 7vw, 82px); }
  .trust h2 { font-size: clamp(2.4rem, 4vw, 3.6rem); }
  .faq { margin: 0 auto; max-width: 900px; padding: 0 32px 130px; }
  .faq-list { border-top: 1px solid #cfdaea; margin-top: 50px; }
  details { border-bottom: 1px solid #cfdaea; padding: 24px 4px; }
  summary { cursor: pointer; font-size: 1.08rem; font-weight: 750; }
  details p { color: #617189; line-height: 1.65; max-width: 720px; padding: 16px 34px 4px 0; }
  .final-cta { align-items: center; background: linear-gradient(140deg, #102a50, #07162b); color: white; display: flex; flex-direction: column; padding: 100px 32px; text-align: center; }
  .final-cta img { margin-bottom: 32px; }
  .final-cta h2 { color: white; margin-bottom: 32px; }
  .sales-footer { background: #06101f; color: #9aabc2; display: grid; font-size: .76rem; gap: 18px 40px; grid-template-columns: auto 1fr; padding: 34px max(32px, calc((100vw - 1136px)/2)); }
  .sales-footer nav { display: flex; gap: 24px; justify-self: end; }
  .sales-footer p { grid-column: 1 / -1; line-height: 1.6; max-width: 800px; }
  @media (min-width: 801px) and (max-width: 1050px) {
    .app-easymode .hero { display: block; max-width: 780px; padding-top: 70px; }
    .app-easymode .hero-copy { margin: 0 auto; max-width: 680px; text-align: center; }
    .app-easymode .hero-copy .lede { margin-left: auto; margin-right: auto; }
    .app-easymode .hero-actions { justify-content: center; }
    .app-easymode .hero-art { margin: 42px auto 0; max-width: 620px; }
    .app-easymode .hero-art img { width: 68%; }
  }
  @media (max-width: 800px) {
    .sales-nav { padding: 18px 20px; }
    .hero { display: block; min-height: 0; padding: 70px 22px 0; }
    h1 { font-size: clamp(3.2rem, 13vw, 4.5rem); }
    .hero-art { height: 640px; margin-top: 4px; }
    .hero-art img { bottom: auto; top: 24px; width: 80%; }
    .orb-one { height: 440px; width: 440px; }
    .promise-strip { font-size: .72rem; gap: 12px; padding: 22px 16px; }
    .live-tools { display: block; padding: 80px 22px 10px; }
    .live-tool-links { margin-top: 40px; }
    .story { padding: 90px 22px 30px; }
    .story-row, .story-row.reverse { display: flex; flex-direction: column; gap: 40px; margin-bottom: 100px; }
    .story-row.reverse .story-copy { order: 0; }
    .screen-card { height: 520px; max-width: 520px; padding: 32px 34px 0; width: 100%; }
    .trust { border-radius: 0; display: block; margin-bottom: 100px; padding: 70px 24px; }
    .trust > p { margin-top: 32px; }
    .faq { padding: 0 24px 100px; }
    .sales-footer { display: flex; flex-direction: column; }
    .sales-footer nav { justify-self: auto; }
  }
  @media (max-width: 480px) {
    .nav-cta { font-size: .8rem; }
    .hero-art { height: 600px; }
    .hero-art img { width: 92%; }
    .promise-strip { grid-template-columns: 1fr; }
    .promise-strip span + span { border-left: 0; }
    .screen-card { height: 480px; }
  }
</style>
