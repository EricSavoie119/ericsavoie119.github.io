  .mode-price .refresh-timer strong.is-updating { color: #ffb866; }
  .answer-date { color: #849d90; font-size: .75rem; margin-top: 18px; }
  .answer-label { color: #b8cdc1; font-size: .75rem; font-weight: 800; letter-spacing: .1em; margin-top: 42px; text-transform: uppercase; }
  .answer-time { align-items: center; display: flex; font-size: clamp(3rem, 6vw, 5.2rem); font-weight: 850; gap: 10px; letter-spacing: -.06em; line-height: 1; margin: 12px 0 45px; white-space: nowrap; }
  .answer-time span { color: #63df9e; font-weight: 400; }
  .mode-price .answer-time span { color: #ffb866; }
  .answer-metrics { border-top: 1px solid rgba(255,255,255,.14); display: grid; gap: 20px; grid-template-columns: 1fr 1fr; padding-top: 25px; }
  .answer-metrics span { color: #9db2a6; display: block; font-size: .72rem; margin-bottom: 5px; }
  .answer-metrics strong { font-size: 1.05rem; }
  .updated { bottom: 22px; color: #789084; font-size: .68rem; position: absolute; }
  .unavailable { color: #b8cdc1; line-height: 1.7; margin-top: 80px; }
  .window-section { background: #fff; padding: 120px max(28px, calc((100vw - 1124px) / 2)); }
  .section-heading { display: grid; gap: 15px 70px; grid-template-columns: 1.1fr .9fr; margin-bottom: 65px; }
  .section-heading .eyebrow { grid-column: 1 / -1; margin: 0; }
  .section-heading > p:last-child { align-self: end; color: #637168; line-height: 1.65; }
  .window-grid { display: grid; gap: 16px; grid-template-columns: repeat(4, 1fr); }
  .window-card { background: #f6faf7; border: 1px solid #deebe3; border-radius: 20px; min-height: 250px; padding: 24px; }
  .mode-price .window-card { background: #fdf8f3; border-color: #eee0d3; }
