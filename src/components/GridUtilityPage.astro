---
import type {
  AgileRegionData,
  UtilityRecommendation,
} from '../lib/gridMetricsData';

interface Props {
  mode: 'carbon' | 'price';
  eyebrow: string;
  title: string;
  intro: string;
  generatedAt: string;
  recommendationDate: string | null;
  recommendations: UtilityRecommendation[];
  regions?: AgileRegionData[];
  activeRegionCode?: string;
  available: boolean;
  sourceLabel: string;
  sourceUrl: string;
  explanation: string;
  appStoreUrl?: string;
  campaignToken?: string;
}

const {
  mode,
  eyebrow,
  title,
  intro,
  generatedAt,
  recommendationDate,
  recommendations,
  regions = [],
  activeRegionCode = 'C',
  available,
  sourceLabel,
  sourceUrl,
  explanation,
  appStoreUrl = 'https://apps.apple.com/gb/app/gridmetrics/id6752292390',
  campaignToken,
} = Astro.props;

const primary = recommendations.find((item) => item.minutes === 120 && item.window)
  ?? recommendations.find((item) => item.window);
const defaultDuration = primary?.minutes ?? 120;
const durationAdjective = (minutes: number) => minutes < 60
  ? `${minutes}-minute`
  : `${minutes / 60}-hour`;
const icon = '/assets/images/apps/GridMetrics/1024.png';
const formatTime = (value?: string) => value
  ? new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(value))
  : '—';
const formatDate = (value?: string | null) => value
  ? new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(`${value}T12:00:00Z`))
  : 'Next available day';
const formatGeneratedAt = (value: string) => new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Europe/London',
  day: 'numeric',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date(value));
const clientPayload = JSON.stringify({
  mode,
  base: { recommendationDate, recommendations },
  regions: Object.fromEntries(regions.map((region) => [region.code, region])),
});
---

<div class:list={['utility-page', `mode-${mode}`]} data-generated-at={generatedAt} data-default-duration={defaultDuration}>
  <header class="utility-nav">
    <a class="brand" href="/apps/gridmetrics/" aria-label="GridMetrics home">
      <img src={icon} alt="" width="36" height="36" />
      <span>GridMetrics</span>
    </a>
    <nav aria-label="GridMetrics utilities">
      <a class:list={{ active: mode === 'carbon' }} href="/apps/gridmetrics/cleanest-time-today/">Cleanest</a>
      <a class:list={{ active: mode === 'price' }} href="/apps/gridmetrics/octopus-agile-cheapest-time-today/">Cheapest</a>
    </nav>
  </header>

  <main>
    <section class="utility-tool">
      <div class="input-column">
        <div class="tool-heading">
          <p class="eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
          <p class="intro">{intro}</p>
        </div>

        <div class="tool-controls">
          {regions.length > 0 && (
            <label class="field-control">
              <span>Region</span>
              <select id="region-select" aria-label="Choose an Octopus Agile electricity region" data-analytics-event="utility_region_changed" data-analytics-app="GridMetrics" data-analytics-placement="cheapest_time_tool">
                {regions.map((region) => (
                  <option value={region.code} selected={region.code === activeRegionCode}>{region.name}</option>
                ))}
              </select>
            </label>
          )}

          <fieldset class="duration-control">
            <legend>Duration</legend>
            <div class="duration-options">
              {recommendations.map((item) => (
                <button
                  type="button"
                  data-duration={item.minutes}
                  data-analytics-event="utility_duration_changed"
                  data-analytics-app="GridMetrics"
                  aria-pressed={item.minutes === defaultDuration ? 'true' : 'false'}
                  disabled={!item.window}
                >
                  {item.label}
                </button>
              ))}
            </div>
          </fieldset>
        </div>
      </div>

      <div class="answer-card" aria-live="polite">
        <div class="answer-context">
          <p id="answer-date">{available ? formatDate(recommendationDate) : 'Data unavailable'}</p>
          <p id="answer-label">{mode === 'price' ? 'Cheapest' : 'Cleanest'} {durationAdjective(defaultDuration)} window</p>
        </div>

        <p class="answer-time" id="answer-time">
          {available && primary?.window ? (
            <>{formatTime(primary.window.start)}<span>–</span>{formatTime(primary.window.end)}</>
          ) : '—'}
        </p>

        <div class="answer-metrics">
          <div>
            <span>{mode === 'price' ? 'Average rate' : 'Average forecast'}</span>
            <strong id="answer-value">
              {available && primary?.window
                ? `${primary.window.value.toFixed(mode === 'price' ? 2 : 0)} ${mode === 'price' ? 'p/kWh' : 'gCO₂/kWh'}`
                : 'Unavailable'}
            </strong>
          </div>
          <div>
            <span>{mode === 'price' ? 'Example cost' : 'Signal'}</span>
            <strong id="answer-secondary">
              {available && primary?.window
                ? mode === 'price' && primary.window.costPence !== undefined
                  ? `${primary.window.costPence.toFixed(0)}p`
                  : 'Lower carbon'
                : 'Check again shortly'}
            </strong>
          </div>
        </div>

        <p class="updated">Updated <time datetime={generatedAt}>{formatGeneratedAt(generatedAt)}</time> UK time</p>
      </div>

      <details class="source-note">
        <summary>How this is calculated</summary>
        <div>
          <p>{explanation}</p>
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer">Source: {sourceLabel} ↗</a>
        </div>
      </details>

      <div class="app-cta">
        <img src={icon} alt="GridMetrics app icon" width="56" height="56" />
        <div>
          <strong>GridMetrics for iPhone</strong>
          <span>Widgets, alerts and both forecasts.</span>
        </div>
        <a href={appStoreUrl} data-app-store-cta="utility_result" data-analytics-app="GridMetrics" data-analytics-campaign-token={campaignToken} target="_blank" rel="noopener noreferrer">Get the app</a>
      </div>
    </section>
  </main>

  <footer class="utility-footer">
    <p>GridMetrics is independent and is not affiliated with NESO or Octopus Energy. Figures are informational estimates, not billing advice.</p>
    <nav aria-label="Footer">
      <a href="mailto:gridmetrics@savoie.app">Support</a>
      <a href="/legal/privacy-policy/">Privacy</a>
    </nav>
  </footer>

  <script id="utility-data" type="application/json" set:html={clientPayload} />
</div>

<script is:inline>
  (() => {
    const page = document.querySelector('.utility-page');
    const payloadElement = document.querySelector('#utility-data');
    const regionSelect = document.querySelector('#region-select');
    const durationButtons = [...document.querySelectorAll('[data-duration]')];
    if (!(page instanceof HTMLElement) || !(payloadElement instanceof HTMLScriptElement)) return;

    const payload = JSON.parse(payloadElement.textContent || '{}');
    let selectedDuration = Number(page.dataset.defaultDuration || 120);
    const time = (value) => new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit', hour12: false,
    }).format(new Date(value));
    const date = (value) => new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/London', weekday: 'long', day: 'numeric', month: 'long',
    }).format(new Date(`${value}T12:00:00Z`));
    const currentData = () => regionSelect instanceof HTMLSelectElement
      ? payload.regions[regionSelect.value]
      : payload.base;

    const update = () => {
      const data = currentData();
      if (!data) return;
      const availableDurations = data.recommendations.filter((item) => item.window);
      let recommendation = availableDurations.find((item) => item.minutes === selectedDuration);
      if (!recommendation) {
        recommendation = availableDurations.find((item) => item.minutes === 120) || availableDurations[0];
        if (recommendation) selectedDuration = recommendation.minutes;
      }

      durationButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        const minutes = Number(button.dataset.duration);
        const item = data.recommendations.find((candidate) => candidate.minutes === minutes);
        button.disabled = !item?.window;
        button.setAttribute('aria-pressed', String(minutes === selectedDuration));
      });

      if (!recommendation?.window) return;
      const duration = recommendation.minutes < 60 ? `${recommendation.minutes}-minute` : `${recommendation.minutes / 60}-hour`;
      document.querySelector('#answer-date').textContent = date(data.recommendationDate);
      document.querySelector('#answer-label').textContent = `${payload.mode === 'price' ? 'Cheapest' : 'Cleanest'} ${duration} window`;
      document.querySelector('#answer-time').innerHTML = `${time(recommendation.window.start)}<span>–</span>${time(recommendation.window.end)}`;
      document.querySelector('#answer-value').textContent = `${recommendation.window.value.toFixed(payload.mode === 'price' ? 2 : 0)} ${payload.mode === 'price' ? 'p/kWh' : 'gCO₂/kWh'}`;
      document.querySelector('#answer-secondary').textContent = payload.mode === 'price'
        ? `${recommendation.window.costPence.toFixed(0)}p`
        : 'Lower carbon';

      try {
        localStorage.setItem(`gridmetrics-${payload.mode}-duration`, String(selectedDuration));
        if (regionSelect instanceof HTMLSelectElement) localStorage.setItem('gridmetrics-agile-region', regionSelect.value);
      } catch {}
    };

    try {
      const savedDuration = Number(localStorage.getItem(`gridmetrics-${payload.mode}-duration`));
      if (savedDuration) selectedDuration = savedDuration;
      if (regionSelect instanceof HTMLSelectElement) {
        const savedRegion = localStorage.getItem('gridmetrics-agile-region');
        if (savedRegion && payload.regions[savedRegion]) regionSelect.value = savedRegion;
      }
    } catch {}

    durationButtons.forEach((button) => button.addEventListener('click', () => {
      selectedDuration = Number(button.dataset.duration);
      update();
    }));
    if (regionSelect instanceof HTMLSelectElement) regionSelect.addEventListener('change', update);
    update();
  })();
</script>

<style>
  .utility-page { --accent: #167445; --soft: #e8f7ef; --ink: #102119; background: #f7faf8; color: var(--ink); font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; min-height: 100vh; overflow-x: clip; }
  .utility-page.mode-price { --accent: #a64b12; --soft: #fff1e3; --ink: #24170f; background: #fdfaf6; }
  .utility-nav { align-items: center; display: flex; justify-content: space-between; margin: 0 auto; max-width: 900px; padding: 22px 24px; }
  .brand { align-items: center; display: flex; font-weight: 850; gap: 10px; letter-spacing: -.02em; }
  .brand img, .app-cta img { border-radius: 22%; box-shadow: 0 7px 18px rgba(18, 62, 39, .12); }
  .utility-nav nav { align-items: center; display: flex; gap: 8px; }
  .utility-nav nav a { border-radius: 999px; color: #68756e; font-size: .78rem; font-weight: 750; padding: 8px 12px; }
  .utility-nav nav a.active { background: var(--soft); color: var(--accent); }
  .utility-tool { display: grid; gap: 22px 54px; grid-template-columns: minmax(280px, .78fr) minmax(440px, 1.22fr); margin: 0 auto; max-width: 1040px; padding: 76px 24px 90px; }
  .input-column { align-self: center; min-width: 0; }
  .tool-heading { max-width: 720px; }
  .eyebrow { color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .14em; margin-bottom: 16px; text-transform: uppercase; }
  h1 { font-size: clamp(3.15rem, 4.8vw, 4.35rem); letter-spacing: -.06em; line-height: .94; margin: 0; }
  .intro { color: #68756e; font-size: 1.08rem; line-height: 1.55; margin-top: 22px; }
  .mode-price .intro { color: #78665b; }
  .tool-controls { display: block; margin-top: 42px; }
  .field-control > span, .duration-control legend { display: block; font-size: .72rem; font-weight: 800; margin-bottom: 8px; }
  .field-control select { appearance: none; background: #fff; border: 1px solid #dce6e0; border-radius: 14px; color: inherit; font: inherit; font-weight: 700; min-height: 48px; padding: 0 14px; width: 100%; }
  .mode-price .field-control select { border-color: #eadfd6; }
  .duration-control { border: 0; margin: 18px 0 0; min-width: 0; padding: 0; }
  .duration-options { background: rgba(255,255,255,.72); border: 1px solid #dce6e0; border-radius: 14px; display: grid; gap: 4px; grid-template-columns: repeat(4, 1fr); padding: 4px; }
  .mode-price .duration-options { border-color: #eadfd6; }
  .duration-options button { background: transparent; border: 0; border-radius: 10px; color: #68756e; cursor: pointer; font: inherit; font-size: .78rem; font-weight: 800; min-height: 44px; padding: 0 8px; }
  .duration-options button[aria-pressed="true"] { background: var(--ink); color: #fff; }
  .duration-options button:disabled { cursor: not-allowed; opacity: .35; }
  .answer-card { align-self: stretch; background: var(--ink); border-radius: 32px; box-shadow: 0 28px 70px rgba(18, 62, 39, .17); color: #fff; container-type: inline-size; display: flex; flex-direction: column; grid-column: 2; justify-content: center; min-height: 470px; min-width: 0; overflow: hidden; padding: clamp(32px, 5vw, 54px); }
  .mode-price .answer-card { box-shadow: 0 28px 70px rgba(111, 61, 22, .16); }
  .answer-context { align-items: baseline; color: #9db2a6; display: flex; font-size: .73rem; font-weight: 750; justify-content: space-between; }
  .mode-price .answer-context { color: #c1ab9d; }
  .answer-label { letter-spacing: .08em; text-transform: uppercase; }
  .answer-time { align-items: center; display: flex; font-size: clamp(3rem, 15cqw, 5.8rem); font-weight: 850; gap: 10px; letter-spacing: -.07em; line-height: .94; margin: 40px 0 46px; white-space: nowrap; }
  .answer-time span { color: #63df9e; font-weight: 350; }
  .mode-price .answer-time span { color: #ffb866; }
  .answer-metrics { border-top: 1px solid rgba(255,255,255,.14); display: grid; gap: 24px; grid-template-columns: 1fr 1fr; padding-top: 24px; }
  .answer-metrics span { color: #9db2a6; display: block; font-size: .7rem; margin-bottom: 5px; }
  .mode-price .answer-metrics span { color: #c1ab9d; }
  .answer-metrics strong { font-size: 1.05rem; }
  .updated { color: #789084; font-size: .67rem; margin-top: 24px; }
  .mode-price .updated { color: #9e8779; }
  .source-note { color: #68756e; font-size: .78rem; grid-column: 1 / -1; line-height: 1.55; margin: 12px 4px 0; }
  .source-note summary { color: var(--accent); cursor: pointer; font-weight: 800; list-style-position: outside; width: fit-content; }
  .source-note > div { align-items: start; display: flex; gap: 24px; justify-content: space-between; margin-top: 12px; }
  .source-note p { max-width: 650px; }
  .source-note a { color: var(--accent); font-weight: 800; white-space: nowrap; }
  .app-cta { align-items: center; background: var(--soft); border-radius: 22px; display: grid; gap: 16px; grid-column: 1 / -1; grid-template-columns: auto 1fr auto; margin-top: 24px; padding: 22px; }
  .app-cta div { display: flex; flex-direction: column; gap: 4px; }
  .app-cta strong { font-size: .98rem; }
  .app-cta span { color: #68756e; font-size: .78rem; }
  .app-cta > a { background: var(--ink); border-radius: 999px; color: #fff; font-size: .78rem; font-weight: 800; padding: 11px 16px; white-space: nowrap; }
  .utility-footer { border-top: 1px solid rgba(80,100,89,.12); color: #7b8881; display: flex; font-size: .68rem; gap: 30px; justify-content: space-between; margin: 0 auto; max-width: 900px; padding: 28px 24px 34px; }
  .utility-footer p { line-height: 1.55; max-width: 660px; }
  .utility-footer nav { display: flex; gap: 16px; white-space: nowrap; }
  @media (max-width: 900px) {
    .utility-tool { display: block; max-width: 760px; padding: 56px 24px 80px; }
    .tool-heading { max-width: 620px; }
    .tool-controls { margin-top: 38px; }
    .answer-card { border-radius: 28px; display: block; margin-top: 22px; min-height: 0; padding: clamp(30px, 7vw, 50px); }
    .answer-time { font-size: clamp(3rem, 14cqw, 5.6rem); }
    .source-note { margin-top: 20px; }
  }
  @media (max-width: 680px) {
    .utility-nav { padding: 17px 18px; }
    .utility-tool { padding: 36px 18px 70px; }
    h1 { font-size: clamp(3.2rem, 15vw, 4.6rem); }
    .tool-controls { display: block; margin-top: 36px; }
    .duration-control { margin-top: 18px; }
    .answer-card { border-radius: 24px; margin-top: 20px; padding: 28px 24px; }
    .answer-context { align-items: flex-start; flex-direction: column; gap: 6px; }
    .answer-time { font-size: clamp(2.65rem, 14cqw, 4.4rem); gap: 6px; margin: 34px 0 38px; }
    .source-note > div { display: block; }
    .source-note a { display: inline-block; margin-top: 10px; }
    .app-cta { grid-template-columns: auto 1fr; }
    .app-cta > a { grid-column: 1 / -1; text-align: center; }
    .utility-footer { flex-direction: column; }
  }
  @media (max-width: 390px) {
    .utility-nav nav a { padding: 7px 9px; }
    .brand span { display: none; }
    .duration-options button { font-size: .7rem; padding: 0 4px; }
    .answer-time { font-size: 3rem; }
  }
</style>
