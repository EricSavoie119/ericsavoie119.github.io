  .window-card-top span:first-child { color: var(--utility-accent); font-weight: 850; text-transform: uppercase; }
  .window-time { display: block; font-size: clamp(1.3rem, 2vw, 1.8rem); letter-spacing: -.04em; }
  .window-value { color: #3f5147; font-size: .84rem; font-weight: 700; margin-top: 10px; }
  .window-note, .window-empty { color: #7a887f; font-size: .72rem; line-height: 1.5; margin-top: 22px; }
  .explanation { display: grid; gap: clamp(50px, 10vw, 140px); grid-template-columns: 1fr 1fr; margin: 0 auto; max-width: 1124px; padding: 130px 28px; }
  .explanation-copy { color: #5f7066; font-size: 1.02rem; line-height: 1.75; }
  .mode-price .explanation-copy { color: #74645a; }
  .explanation-copy p + p { margin-top: 20px; }
  .explanation-copy a { color: var(--utility-accent); display: inline-block; font-size: .82rem; font-weight: 800; margin-top: 26px; }
  .appliance-examples { background: var(--utility-soft); padding: 110px max(28px, calc((100vw - 1124px) / 2)); }
  .appliance-examples h2 { max-width: 680px; }
  .example-grid { display: grid; gap: 18px; grid-template-columns: repeat(3, 1fr); margin-top: 60px; }
  .example-grid > div { background: rgba(255,255,255,.74); border-radius: 20px; padding: 28px; }
  .example-grid span { color: var(--utility-accent); display: block; font-size: 1.8rem; margin-bottom: 40px; }
  .example-grid strong { display: block; font-size: 1.05rem; }
  .example-grid p { color: #65756b; font-size: .82rem; line-height: 1.55; margin-top: 8px; }
  .app-cta { align-items: center; background: #102119; color: #fff; display: grid; gap: 36px; grid-template-columns: auto 1fr auto; padding: 85px max(28px, calc((100vw - 1124px) / 2)); }
  .mode-price .app-cta { background: #24170f; }
  .app-cta h2 { font-size: clamp(2.2rem, 4vw, 3.8rem); }
  .app-cta p:not(.eyebrow) { color: #a9bdb1; line-height: 1.6; margin-top: 16px; max-width: 650px; }
  .store-button { align-items: center; background: #fff; border-radius: 14px; color: #102119; display: inline-flex; font-weight: 800; gap: 10px; line-height: 1.05; padding: 12px 18px; white-space: nowrap; }
  .store-button > span:first-child { font-family: -apple-system, sans-serif; font-size: 1.65rem; }
  .store-button small { display: block; font-size: .6rem; font-weight: 600; margin-bottom: 2px; }
  .utility-footer { background: #09150f; color: #84968c; display: flex; font-size: .72rem; gap: 40px; justify-content: space-between; padding: 34px max(28px, calc((100vw - 1124px) / 2)); }
  .mode-price .utility-footer { background: #160d08; }
  .utility-footer p { line-height: 1.6; max-width: 700px; }
  .utility-footer nav { display: flex; gap: 20px; white-space: nowrap; }
  @media (max-width: 850px) {
    .utility-nav nav > a:not(.nav-cta) { display: none; }
    .utility-hero { display: block; min-height: 0; padding: 70px 22px 90px; }
    .answer-card { margin-top: 58px; }
    .window-section { padding: 90px 22px; }
    .section-heading, .explanation { display: block; }
    .section-heading > p:last-child { margin-top: 22px; }
    .window-grid { grid-template-columns: repeat(2, 1fr); }
    .explanation { padding: 90px 22px; }
    .explanation-copy { margin-top: 35px; }
    .appliance-examples { padding: 90px 22px; }
