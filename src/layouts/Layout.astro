---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageAlt?: string;
  analyticsPageType?: string;
  analyticsApp?: string;
  analyticsExperimentId?: string;
  noindex?: boolean;
  appleAppId?: string;
}

const {
  title,
  description = 'Small iPhone apps across productivity, finance, and utilities.',
  canonicalUrl = 'https://savoie.app/',
  ogImage = 'https://savoie.app/assets/images/savoie-apps-social-preview.png',
  ogImageAlt,
  analyticsPageType = 'website',
  analyticsApp,
  analyticsExperimentId,
  noindex = false,
  appleAppId,
} = Astro.props;
const resolvedOgImageAlt = ogImageAlt ?? title;
const usesBrandPreview = ogImage.endsWith('/assets/images/savoie-apps-social-preview.png');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Savoie Apps" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {appleAppId && <meta name="apple-itunes-app" content={`app-id=${appleAppId}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Savoie Apps" />
    <meta property="og:image" content={ogImage} />
    {usesBrandPreview && <meta property="og:image:width" content="1200" />}
    {usesBrandPreview && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body
    data-analytics-page-type={analyticsPageType}
    data-analytics-app={analyticsApp}
    data-analytics-experiment-id={analyticsExperimentId}
  >
    <slot />
    <script>
      import '../scripts/analytics';
    </script>
  </body>
</html>
